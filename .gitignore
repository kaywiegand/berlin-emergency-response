# .gitignore – dbt + DuckDB + Streamlit (uv)
# uv.lock gehört in Git. dbt-Modelle, Seeds und profiles.yml (nur DuckDB-Pfad, keine Secrets) ebenfalls.

# ── Daten (nur unter data/, damit dbt/seeds/*.csv versioniert werden) ──────────
data/raw/
data/interim/
data/processed/
data/*.csv
data/*.parquet
data/*.duckdb
data/*.duckdb.wal
*.xlsx
*.feather
*.h5
*.hdf5

# ── Artefakte ──────────────────────────────────────────────────────────────
*.pkl
*.joblib
*.pt
*.pth

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# ── Umgebung ───────────────────────────────────────────────────────────────
.venv/
.env
*.env

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_metadata

# ── dbt ────────────────────────────────────────────────────────────────────
target/
dbt_packages/
dbt_modules/
dbt_internal_packages/
logs/
.user.yml

# ── IDE & OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
